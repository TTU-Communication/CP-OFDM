{
    "equalizer":
    {
        "inputs":
        [
            {"name":"inSig",       "kind":"required",  "type":["numeric", "2d"]},
            {"name":"H",           "kind":"required",  "type":["numeric", "2d"]},
            {"name":"noisePower",  "kind":"ordered",   "type":["numeric", "2d"]},
            {"name":"sigPower",    "kind":"ordered",   "type":["numeric", "2d"]}
        ],
        "outputs":
        [
            {"name":"afterEQ",   "type":["double", "2d"]}
        ]
    },
    "getNullIdx":
    {
        "inputs":
        [
            {"name":"nfft",     "kind":"required", "type":["numeric", "scalar", ">0"], "purpose":"FFT size"},
            {"name":"length",   "kind":"ordered",  "type":["numeric", "scalar", ">0"], "purpose":"Guard Band Size"},
            {"name":"DCLength", "kind":"ordered",  "type":["numeric", "scalar", ">0"], "purpose":"DC Length"}
        ],
        "outputs":
        [
            {"name":"nullIdx",   "type":["double", "column"]}
        ]
    }
}
